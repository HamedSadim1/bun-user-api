{
  "name": "bun-user-api",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "husky": "^9.1.7",
